// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "vim_mode": false,
  "disable_ai": true,
  "project_panel": {
    "auto_fold_dirs": false,
    "git_status": true,
    "dock": "right",
  },
  "terminal": {
    "dock": "left",
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Ayu Mirage",
    "dark": "One Dark",
  },
  "buffer_font_features": {
    "calt": false,
  },
  "languages": {
    "YAML": {},
    "C++": {
      "tab_size": 2,
      "hard_tabs": false,
    },
    "C": {
      "tab_size": 2,
      "hard_tabs": false,
    },
    "Dockerfile": {
      "tab_size": 4,
      "hard_tabs": false,
    },
  },
  "file_scan_exclusions": ["**/.git", "**/node_modules"],
  "lsp": {
    "biome": {
      "binary": {
        "path": "/var/biome-2.2.3/bin/biome",
        "arguments": ["lsp-proxy"],
      },
    },
    "clangd": {
      "binary": {
        "path": "/usr/bin/clangd",
        "arguments": [
          "--query-driver=/usr/bin/g++-12",
          "--compile-commands-dir=/home/tamir/polaris-v3/build",
          "--background-index",
          "--clang-tidy"
        ],
      },
    },
  },
}
